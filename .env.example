# Copy to .env.local for local overrides, or set these in Vercel (Project → Settings → Environment Variables).
# Locally none are required: the app uses data/bouldleads.db and has no login.

# Hosted database (Turso). Created via the Vercel Marketplace, which sets both for you.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Encrypts inbox passwords and API keys stored in the database. Any long random string; never change it later.
BOULDLEADS_SECRET=

# Team logins. One entry per person, made with: npm run hash-password -- Jake 'his-password'
APP_USERS=
# Signs login cookies. Any long random string.
SESSION_SECRET=

# Protects /api/cron/tick (the every-minute background job). Any long random string.
CRON_SECRET=

# Public API for bouldhq.com (ranking-check requests, results links at bouldhq.com/check/...).
# Any long random string; set the same value as BOULDLEADS_SECRET in the bouldhq-web project.
PUBLIC_API_SECRET=
# Where results links point. Defaults to https://bouldhq.com.
BOULD_SITE_URL=

# Optional: set keys here instead of in Settings.
GOOGLE_PLACES_API_KEY=
ANTHROPIC_API_KEY=
